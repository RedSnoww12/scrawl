{
  "name": "scrawl",
  "private": true,
  "version": "1.0.0",
  "description": "A hand-drawn whiteboard you can share: sketchy shapes, folders, Google sign-in and live collaboration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RedSnoww12/scrawl.git"
  },
  "homepage": "https://scrawl-seven.vercel.app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
